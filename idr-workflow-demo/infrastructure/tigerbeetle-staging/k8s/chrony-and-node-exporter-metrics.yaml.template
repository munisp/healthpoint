# TEMPLATE-ONLY. This deploys read-only exporters, not a Chrony daemon. Chronyd
# must be installed and managed by the approved node OS/image lifecycle with
# authenticated time sources. Deploy only after validating the real socket path,
# socket group, Node Exporter image capability requirement, node selectors, and
# Prometheus Operator labels in staging. Render this file once for each exact
# TIMING_ROLE: application, cni, otel_collector, and prometheus. Each rendered
# copy schedules only onto nodes labelled healthpoint.io/timing-role=<role>.
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: chrony-exporter-${TIMING_ROLE}
  namespace: ${TIGERBEETLE_OBSERVABILITY_NAMESPACE}
  labels:
    app.kubernetes.io/part-of: healthpoint
    app.kubernetes.io/component: chrony-exporter
automountServiceAccountToken: false
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: chrony-exporter-${TIMING_ROLE}
  namespace: ${TIGERBEETLE_OBSERVABILITY_NAMESPACE}
  labels:
    app.kubernetes.io/part-of: healthpoint
    app.kubernetes.io/component: chrony-exporter
spec:
  selector:
    matchLabels:
      app.kubernetes.io/part-of: healthpoint
      app.kubernetes.io/component: chrony-exporter
      healthpoint_timing_role: ${TIMING_ROLE}
  updateStrategy:
    type: RollingUpdate
    rollingUpdate: { maxUnavailable: 1 }
  template:
    metadata:
      labels:
        app.kubernetes.io/part-of: healthpoint
        app.kubernetes.io/component: chrony-exporter
        healthpoint_timing_role: ${TIMING_ROLE}
    spec:
      serviceAccountName: chrony-exporter-${TIMING_ROLE}
      automountServiceAccountToken: false
      nodeSelector:
        kubernetes.io/os: linux
        healthpoint.io/timing-role: ${TIMING_ROLE}
      securityContext:
        runAsNonRoot: true
        runAsUser: ${CHRONY_EXPORTER_UID}
        runAsGroup: ${CHRONY_EXPORTER_GID}
        fsGroup: ${CHRONY_SOCKET_GID}
        seccompProfile: { type: RuntimeDefault }
      containers:
        - name: chrony-exporter
          image: ${CHRONY_EXPORTER_IMAGE_DIGEST}
          imagePullPolicy: IfNotPresent
          args:
            - --chrony.address=unix://${CHRONY_SOCKET_PATH}
            - --chrony.timeout=5s
            - --collector.tracking
            - --collector.sources
            - --web.listen-address=:9123
            - --web.telemetry-path=/metrics
            - --log.format=json
          ports:
            - { name: metrics, containerPort: 9123, protocol: TCP }
          readinessProbe:
            httpGet: { path: /metrics, port: metrics }
            initialDelaySeconds: 5
            periodSeconds: 15
            timeoutSeconds: 3
            failureThreshold: 3
          livenessProbe:
            httpGet: { path: /metrics, port: metrics }
            initialDelaySeconds: 15
            periodSeconds: 30
            timeoutSeconds: 3
            failureThreshold: 3
          resources:
            requests: { cpu: 25m, memory: 32Mi }
            limits: { cpu: 100m, memory: 96Mi }
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: { drop: ["ALL"] }
            readOnlyRootFilesystem: true
            runAsNonRoot: true
          volumeMounts:
            - { name: chrony-socket, mountPath: /run/chrony, readOnly: true }
      volumes:
        - name: chrony-socket
          hostPath:
            path: /run/chrony
            type: Directory
---
apiVersion: v1
kind: Service
metadata:
  name: chrony-exporter-${TIMING_ROLE}
  namespace: ${TIGERBEETLE_OBSERVABILITY_NAMESPACE}
  labels:
    app.kubernetes.io/part-of: healthpoint
    app.kubernetes.io/component: chrony-exporter
    healthpoint_timing_role: ${TIMING_ROLE}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/part-of: healthpoint
    app.kubernetes.io/component: chrony-exporter
    healthpoint_timing_role: ${TIMING_ROLE}
  ports:
    - { name: metrics, port: 9123, targetPort: metrics, protocol: TCP }
---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: chrony-exporter-${TIMING_ROLE}
  namespace: ${TIGERBEETLE_OBSERVABILITY_NAMESPACE}
  labels:
    app.kubernetes.io/part-of: healthpoint
spec:
  selector:
    matchLabels:
      app.kubernetes.io/component: chrony-exporter
      healthpoint_timing_role: ${TIMING_ROLE}
  endpoints:
    - port: metrics
      path: /metrics
      interval: 15s
      scrapeTimeout: 5s
      relabelings:
        - sourceLabels: [__meta_kubernetes_pod_node_name]
          targetLabel: source_node_name
        - sourceLabels: [__meta_kubernetes_pod_label_healthpoint_timing_role]
          targetLabel: healthpoint_timing_role
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: node-exporter-timex-${TIMING_ROLE}
  namespace: ${TIGERBEETLE_OBSERVABILITY_NAMESPACE}
  labels:
    app.kubernetes.io/part-of: healthpoint
    app.kubernetes.io/component: node-exporter-timex
automountServiceAccountToken: false
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: node-exporter-timex-${TIMING_ROLE}
  namespace: ${TIGERBEETLE_OBSERVABILITY_NAMESPACE}
  labels:
    app.kubernetes.io/part-of: healthpoint
    app.kubernetes.io/component: node-exporter-timex
spec:
  selector:
    matchLabels:
      app.kubernetes.io/part-of: healthpoint
      app.kubernetes.io/component: node-exporter-timex
      healthpoint_timing_role: ${TIMING_ROLE}
  updateStrategy:
    type: RollingUpdate
    rollingUpdate: { maxUnavailable: 1 }
  template:
    metadata:
      labels:
        app.kubernetes.io/part-of: healthpoint
        app.kubernetes.io/component: node-exporter-timex
        healthpoint_timing_role: ${TIMING_ROLE}
    spec:
      serviceAccountName: node-exporter-timex-${TIMING_ROLE}
      automountServiceAccountToken: false
      nodeSelector:
        kubernetes.io/os: linux
        healthpoint.io/timing-role: ${TIMING_ROLE}
      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
        runAsGroup: 65534
        seccompProfile: { type: RuntimeDefault }
      containers:
        - name: node-exporter
          image: ${NODE_EXPORTER_IMAGE_DIGEST}
          imagePullPolicy: IfNotPresent
          args:
            - --web.listen-address=:9100
            - --web.telemetry-path=/metrics
            - --path.procfs=/host/proc
            - --path.sysfs=/host/sys
            - --path.rootfs=/host/root
            - --collector.timex
            - --no-collector.wifi
            - --no-collector.btrfs
            - --no-collector.hwmon
          ports:
            - { name: metrics, containerPort: 9100, protocol: TCP }
          readinessProbe:
            httpGet: { path: /metrics, port: metrics }
            initialDelaySeconds: 5
            periodSeconds: 15
            timeoutSeconds: 3
            failureThreshold: 3
          livenessProbe:
            httpGet: { path: /metrics, port: metrics }
            initialDelaySeconds: 15
            periodSeconds: 30
            timeoutSeconds: 3
            failureThreshold: 3
          resources:
            requests: { cpu: 100m, memory: 128Mi }
            limits: { cpu: 300m, memory: 256Mi }
          securityContext:
            allowPrivilegeEscalation: false
            # Required by Linux adjtimex() for the Node Exporter timex collector.
            # This is the sole capability exception; do not add any other capability.
            capabilities: { drop: ["ALL"], add: ["SYS_TIME"] }
            readOnlyRootFilesystem: true
            runAsNonRoot: true
          volumeMounts:
            - { name: proc, mountPath: /host/proc, readOnly: true }
            - { name: sys, mountPath: /host/sys, readOnly: true }
            - { name: root, mountPath: /host/root, readOnly: true }
      volumes:
        - name: proc
          hostPath: { path: /proc, type: Directory }
        - name: sys
          hostPath: { path: /sys, type: Directory }
        - name: root
          hostPath: { path: /, type: Directory }
---
apiVersion: v1
kind: Service
metadata:
  name: node-exporter-timex-${TIMING_ROLE}
  namespace: ${TIGERBEETLE_OBSERVABILITY_NAMESPACE}
  labels:
    app.kubernetes.io/part-of: healthpoint
    app.kubernetes.io/component: node-exporter-timex
    healthpoint_timing_role: ${TIMING_ROLE}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/part-of: healthpoint
    app.kubernetes.io/component: node-exporter-timex
    healthpoint_timing_role: ${TIMING_ROLE}
  ports:
    - { name: metrics, port: 9100, targetPort: metrics, protocol: TCP }
---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: node-exporter-timex-${TIMING_ROLE}
  namespace: ${TIGERBEETLE_OBSERVABILITY_NAMESPACE}
  labels:
    app.kubernetes.io/part-of: healthpoint
spec:
  selector:
    matchLabels:
      app.kubernetes.io/component: node-exporter-timex
      healthpoint_timing_role: ${TIMING_ROLE}
  endpoints:
    - port: metrics
      path: /metrics
      interval: 15s
      scrapeTimeout: 5s
      relabelings:
        - sourceLabels: [__meta_kubernetes_pod_node_name]
          targetLabel: source_node_name
        - sourceLabels: [__meta_kubernetes_pod_label_healthpoint_timing_role]
          targetLabel: healthpoint_timing_role
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: chrony-and-node-exporter-ingress-from-prometheus-only-${TIMING_ROLE}
  namespace: ${TIGERBEETLE_OBSERVABILITY_NAMESPACE}
spec:
  podSelector:
    matchExpressions:
      - key: app.kubernetes.io/component
        operator: In
        values: [chrony-exporter, node-exporter-timex]
      - key: healthpoint_timing_role
        operator: In
        values: [${TIMING_ROLE}]
  policyTypes: [Ingress, Egress]
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: prometheus
      ports:
        - { protocol: TCP, port: 9123 }
        - { protocol: TCP, port: 9100 }
  egress: []
