# NON-DEPLOYABLE EXAMPLE ONLY.
# Replace every value through a protected infrastructure pipeline. Do not commit
# a real cluster ID, private addresses, image digest, or secret-manager locator.
environment = "staging"
cluster_id  = "REPLACE_WITH_RANDOM_128_BIT_CLUSTER_ID"
tigerbeetle_image = "registry.example.invalid/tigerbeetle@sha256:REPLACE_WITH_64_HEX_DIGEST"
data_directory = "/REPLACE_WITH_MOUNTED_TIGERBEETLE_DATA_DIRECTORY"

replicas = [
  { replica_index = 0, private_address = "10.10.10.10", fault_domain = "zone-a/rack-1", machine_id = "provider-machine-0", data_disk_id = "provider-disk-0" },
  { replica_index = 1, private_address = "10.10.10.11", fault_domain = "zone-a/rack-2", machine_id = "provider-machine-1", data_disk_id = "provider-disk-1" },
  { replica_index = 2, private_address = "10.10.20.10", fault_domain = "zone-b/rack-1", machine_id = "provider-machine-2", data_disk_id = "provider-disk-2" },
  { replica_index = 3, private_address = "10.10.20.11", fault_domain = "zone-b/rack-2", machine_id = "provider-machine-3", data_disk_id = "provider-disk-3" },
  { replica_index = 4, private_address = "10.10.30.10", fault_domain = "zone-c/rack-1", machine_id = "provider-machine-4", data_disk_id = "provider-disk-4" },
  { replica_index = 5, private_address = "10.10.30.11", fault_domain = "zone-c/rack-2", machine_id = "provider-machine-5", data_disk_id = "provider-disk-5" },
]

server_tls_secret_reference = "secret-manager://staging/tigerbeetle/server"
client_tls_secret_reference = "secret-manager://staging/tigerbeetle/client"

# Disabled by default. These values are accepted only from a protected staging
# pipeline after all source checks, rendered-policy checks, and human review.
drill_log_access_gitops = {
  enabled                           = false
  git_commit_sha                    = ""
  manifest_bundle_sha256            = ""
  source_validation_artifact_sha256 = ""
  argocd_application_name           = ""
  argocd_manual_sync_only           = true
}

# Disabled non-deployable clock-metrics handoff. Use a protected pipeline to
# provide actual image digests, socket group ID, host-configuration digest, and
# rendered-manifest artifact hashes. Do not commit time-source addresses or key material.
clock_metrics = {
  enabled                                = false
  chrony_time_source_configuration_sha256 = ""
  chrony_exporter_image                  = ""
  node_exporter_image                    = ""
  healthpoint_app_image                  = ""
  timing_roles                           = []
  chrony_socket_path                     = ""
  chrony_socket_group_id                 = 0
  rendered_exporters_sha256              = ""
  rendered_clock_monitor_sha256          = ""
  rendered_clock_rules_sha256            = ""
  source_validation_artifact_sha256      = ""
  manual_argocd_sync_only                = true
}
