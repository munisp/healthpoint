{
  "realm": "nsa-idr-platform",
  "enabled": true,
  "clients": [
    {
      "clientId": "frontend",
      "secret": "${KEYCLOAK_FRONTEND_CLIENT_SECRET}",
      "publicClient": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["+"]
    },
    {
      "clientId": "backend",
      "secret": "${KEYCLOAK_BACKEND_CLIENT_SECRET}",
      "serviceAccountsEnabled": true
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator"
      },
      {
        "name": "user",
        "description": "Regular user"
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${ADMIN_INITIAL_PASSWORD}"
        }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username": "user",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${USER_INITIAL_PASSWORD}"
        }
      ],
      "realmRoles": ["user"]
    }
  ]
}
