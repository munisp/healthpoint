# Phase 24 (F7): do not run dependency lifecycle scripts (preinstall/
# postinstall/…) on install. The lockfile currently contains zero install
# scripts (verified in the phase-24 supply-chain audit); this keeps it that
# way by default. A package that legitimately needs a build script must be
# allowlisted consciously — see the phase-24 wave notes.
ignore-scripts=true
