{
  "servers": {
    "kafka-mtls": {
      "listen": [":9093"],
      "routes": [
        {
          "handle": [
            {
              "handler": "tls",
              "connection_policies": [
                {
                  "client_authentication": {
                    "mode": "require_and_verify",
                    "trust_pool": {
                      "provider": "file",
                      "pem_files": ["/etc/caddy/certs/ca.crt"]
                    }
                  }
                }
              ]
            },
            {
              "handler": "proxy",
              "upstreams": [
                {
                  "dial": ["kafka:9092"]
                }
              ]
            }
          ],
          "match": [
            {
              "tls": {}
            }
          ]
        }
      ]
    },
