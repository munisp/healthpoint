###############################################################################
# HealthPoint IDR — environment template
# Copy to .env and fill in real values. NEVER commit real secrets.
# Values below are empty or obvious placeholders only. Production startup
# validation (server/_core/index.ts validateEnv, server/_core/env.ts) fails
# closed when required variables are missing or malformed.
###############################################################################

# ── Core application ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# PostgreSQL connection string. Production requires the postgresql:// form
# (or EXTERNAL_POSTGRES_URL with sslmode=verify-ca + sslrootcert).
DATABASE_URL=postgresql://idr_user:change-me@localhost:5432/idr_demo
# Session/JWT signing secret — REQUIRED (min 16 chars; use 32+ random bytes).
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Comma-separated list of allowed CORS origins, exact match (production only)
ALLOWED_ORIGINS=

# ── PostgreSQL (docker-compose service) ─────────────────────────────────────
POSTGRES_USER=idr_user
POSTGRES_PASSWORD=
POSTGRES_DB=idr_demo

# ── Redis (cache, sessions, JWT revocation list, distributed locks) ──────────
REDIS_PASSWORD=
# Full URL consumed by the app; include the password: redis://:<password>@host:6379
REDIS_URL=redis://localhost:6379

# ── Keycloak OIDC (identity provider) ───────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=healthpoint
KEYCLOAK_CLIENT_ID=healthpoint-app
# Optional issuer override when the realm is fronted by a gateway; defaults to
# ${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM}
KEYCLOAK_ISSUER=
# Bootstrap admin password for the docker-compose `start-dev` Keycloak.
# docker-compose.yml requires it explicitly; start-dev is development-only.
KC_ADMIN_PASSWORD=

# ── Bearer access-token verification (mobile app + API clients) ─────────────
# RS256 Keycloak access tokens are verified against the realm JWKS
# (<issuer>/protocol/openid-connect/certs), cached with a TTL.
# Optional JWKS URI override:
KEYCLOAK_JWKS_URI=
# Comma-separated accepted audiences/azp values. Default: KEYCLOAK_CLIENT_ID
# plus healthpoint-app,healthpoint-frontend,healthpoint-backend.
KEYCLOAK_BEARER_AUDIENCES=healthpoint-app,healthpoint-frontend
# iss/exp clock-skew tolerance (seconds)
BEARER_CLOCK_TOLERANCE_SECONDS=60
# JWKS cache TTL (milliseconds)
KEYCLOAK_JWKS_CACHE_TTL_MS=300000

# ── Rate limiting (Redis-backed, server/auth/ratelimit.ts) ──────────────────
# /api/auth/* — strict; fails closed in production when Redis is unavailable
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# /api/settlement/* and /api/fhir/* — strict; fails closed in production
RATE_LIMIT_SENSITIVE_MAX=30
RATE_LIMIT_SENSITIVE_WINDOW_SECONDS=60
# /api/trpc/* — general limiter; fail-open-with-log (read-heavy, low risk)
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_SECONDS=60

# ── Settlement provider callbacks (REQUIRED in production) ──────────────────
# HMAC secret for signed settlement callbacks/reports
SETTLEMENT_CALLBACK_SECRET=
# Versioned keyring, e.g. key1=<hex-secret>,key2=<hex-secret>
SETTLEMENT_CALLBACK_KEYRING=
# Expected provider identifier (defaults to "mojaloop")
SETTLEMENT_CALLBACK_PROVIDER=mojaloop
# PEM of the CA that signs provider mTLS client certificates
SETTLEMENT_MTLS_CLIENT_CA_PEM=
# Comma-separated allowed provider client-certificate SHA-256 fingerprints
SETTLEMENT_MTLS_CLIENT_FINGERPRINTS=
# High-entropy (>= 32 chars) shared token verified at the mTLS ingress
SETTLEMENT_MTLS_INGRESS_TOKEN=

# ── Internal services ────────────────────────────────────────────────────────
# Shared bearer token for internal service-to-service calls (go-services)
INTERNAL_SERVICE_TOKEN=
# Base URL of the Go services (Permify client, Mojaloop connector, ledger)
GO_SERVICES_URL=http://localhost:8001

# ── MinIO / S3-compatible object storage ────────────────────────────────────
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ── OpenSearch (search indices; optional — falls back to in-process Fuse.js) ─
OPENSEARCH_URL=
# Basic-auth credentials for a secured OpenSearch cluster (optional)
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
# TLS certificate verification for an https:// OPENSEARCH_URL. Set to "true"
# to enforce certificate verification (recommended in production); any other
# value (or unset) keeps the legacy lenient behavior for local clusters with
# the security plugin disabled. Wired in server/search.ts (Phase 13 FB, O11).
OPENSEARCH_VERIFY_TLS=

# ── Permify (fine-grained ReBAC authorization) ──────────────────────────────
# HTTP base URL of the Permify check API. Unset = PostgreSQL fallback in
# server/authz.ts. Canonical schema: infra/permify/schema.perm.
PERMIFY_URL=
PERMIFY_TENANT=t1
# Mirror-only Permify WRITE path (default false). When true,
# server/permify-write.ts mirrors tuples to PERMIFY_URL on organization
# membership creation (user_profiles.orgName) and dispute/case creation. It
# FAILS OPEN (error log + event_log audit row) because PostgreSQL remains the
# system of record and all authorization READS stay on the Postgres path in
# server/authz.ts — Permify is a mirror only until a product decision flips
# the read path.
PERMIFY_WRITE_ENABLED=false
# Phase 15 FB (B2): hard enforcement gate. false (default) = current mirror
# behavior (Permify consulted first on dispute authz reads, PostgreSQL
# fallback). true = Permify's verdict HARD-GATES dispute access and the check
# FAILS CLOSED when Permify is unreachable. Requires PERMIFY_URL (asserted by
# scripts/validate-production-config.sh).
PERMIFY_ENFORCE=false

# ── Temporal workflow execution (opt-in, disabled by default) ───────────────
# true = disputes entering STEP_04_IDR_INITIATED also start a durable Temporal
# workflow (server/workflow/idr-workflow.ts → server/temporal.ts); the
# in-process PostgreSQL state machine remains the system of record and is the
# fallback when disabled/unreachable (logged honestly, never faked).
TEMPORAL_EXECUTION_ENABLED=false
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_AUTH_TOKEN=
# Path to the Temporal CA certificate for mTLS (production)
TEMPORAL_CA_PATH=

# ── TigerBeetle ledger (authoritative funds plane via the Go sidecar) ───────
# false (default) = Postgres-only behavior; the ledger wrapper degrades with an
# error log. true enables mirroring of settlement holds/posts/voids/reversals.
TB_LEDGER_ENABLED=false
# true = fail CLOSED when the ledger is unavailable: settlement lifecycle and
# reconciliation throw LedgerIntegrityError instead of silently degrading.
TB_LEDGER_REQUIRED=false
TB_LEDGER_TIMEOUT_MS=3000
TB_LEDGER_PENDING_HOLD_TIMEOUT_SECONDS=86400

# ── Ledger reconciliation (Postgres ledger vs. TigerBeetle balances) ────────
# In-process scheduler cadence in minutes (server/reconciliation-scheduler.ts);
# default 60 = hourly. 0 disables the in-process scheduler (e.g. when an
# external cron drives POST /api/scheduled/ledger-reconciliation instead).
LEDGER_RECONCILIATION_INTERVAL_MINUTES=60

# ── Scheduled endpoints ──────────────────────────────────────────────────────
# Bearer fallback token for /api/scheduled/* — REQUIRED in production
# (startup fails closed without it). Generate with: openssl rand -hex 32
SCHEDULED_SECRET=

# ── Client (Vite build-time variables, exposed to the browser) ──────────────
VITE_APP_TITLE="HealthPoint"
VITE_APP_LOGO=/icons/icon-512.png
VITE_APP_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════════
# Phase 13 FB: variables READ by the codebase that were previously
# undocumented. Values intentionally blank — fill per environment.
# ═══════════════════════════════════════════════════════════════════════════

# ── AI / LLM services ───────────────────────────────────────────────────────
# Base URL of the Python LangGraph AI microservice (ai.* procedures proxy here)
AI_SERVICE_URL=
# Base URL of the local Ollama daemon (default http://localhost:11434)
OLLAMA_BASE_URL=

# ── Built-in storage proxy (Manus-style storage helper) ────────────────────
BUILT_IN_STORAGE_API_URL=
BUILT_IN_STORAGE_API_KEY=

# ── CDS Hooks security ──────────────────────────────────────────────────────
# Shared secret for CDS Hooks JWT verification
CDS_JWT_SECRET=
# true = fail closed when a CDS request JWT is missing/invalid
CDS_JWT_REQUIRED=

# ── CMS claim validation knobs ─────────────────────────────────────────────
# Regex override for CMS reference-number validation
CMS_REF_REGEX=
# Allowed future-dated service-date tolerance (days)
CMS_SERVICE_DATE_FUTURE_TOLERANCE_DAYS=

# ── EMR connection credential encryption ────────────────────────────────────
# AES key for encrypting stored EMR connection credentials (REQUIRED in prod)
EMR_CREDENTIALS_ENCRYPTION_KEY=

# ── External Postgres (read replica / federation) ───────────────────────────
EXTERNAL_POSTGRES_URL=
EXTERNAL_POSTGRES_TLS_SERVER_NAME=

# ── Journeys / test harness (never set in production) ───────────────────────
# Skip LLM stubbing in journey runs
JOURNEYS_NO_LLM_STUB=
# Seed all fixtures for journey runs
JOURNEYS_SEED_ALL=
# Opt-in flag for integration test suites
RUN_INTEGRATION=

# ── Kafka event streaming (optional; in-process bus when unset) ─────────────
KAFKA_BROKERS=
KAFKA_CONSUMER_GROUP=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_PATH=
KAFKA_SSL_CA_PEM=

# ── Notifications: email / SMS / push ───────────────────────────────────────
# From-address for outbound notification email
NOTIFICATION_FROM_EMAIL=
# SendGrid email delivery
SENDGRID_API_KEY=
# SMTP fallback delivery
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Twilio SMS delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Web-push VAPID key pair (BOTH required for web push; generate with
# `npx web-push generate-vapid-keys` or any P-256 keypair, base64url-encoded).
# Either key alone is invalid — the production config validator enforces
# both-or-neither. Without the pair, push dispatch reports 'unconfigured'
# honestly and records the attempt; delivery is never faked.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Subject claim for VAPID JWTs (contact URI per RFC 8292)
VAPID_SUBJECT=
# Explicit kill switch for push fan-out (default: enabled when keys present)
PUSH_NOTIFICATIONS_ENABLED=

# ── Outbox dispatcher ───────────────────────────────────────────────────────
# Poll cadence for the transactional-outbox dispatcher (ms)
OUTBOX_DISPATCH_INTERVAL_MS=

# ── Payments / settlement ───────────────────────────────────────────────────
# Payment execution mode: disabled (default) | sandbox. 'live' initiation is
# NOT implemented (services/go adapter refuses it). HONEST SCOPE:
#  - Outbound payment instructions are SIMULATOR-GRADE only (posted to the
#    Mojaloop simulator below; ILP fields are placeholders per ADR-002).
#  - Inbound settlement callbacks ARE real: signed and mTLS-reconciled
#    (server/_core/index.ts). Legacy unsigned callbacks return 410.
PAYMENT_EXECUTION_MODE=
# Mojaloop endpoint for outbound FSPIOP-shaped transfers. In non-production
# this points at the compose mojaloop/simulator service. Must be HTTPS and
# must NOT be a simulator when PAYMENT_EXECUTION_MODE=sandbox in production
# (enforced by scripts/validate-production-config.sh).
MOJALOOP_URL=
# true = require mutual-TLS on settlement callback ingress
SETTLEMENT_MTLS_REQUIRED=
# Admin fee (USD) applied to PPDR determinations
PPDR_ADMIN_FEE_USD=
# Feature gate for 2027 remittance (835/ERA) flows
REMITTANCE_2027_ENABLED=

# ── Authorization (Permify) ─────────────────────────────────────────────────
# Auth token for the Permify gRPC/REST endpoint
PERMIFY_AUTH_TOKEN=

# ── QPA engine ──────────────────────────────────────────────────────────────
# JSON map of {year: CPI-U factor} fallback when qpa_cpi_factors table is empty
QPA_CPI_FACTORS_JSON=

# ── Lakehouse (Spark/Iceberg pipeline) ──────────────────────────────────────
# true = services/lakehouse/scheduler.py actually runs pipeline.py (requires
# real Spark + MinIO infra). Default/unset = pipeline is NOT scheduled; the
# scheduler logs 'unconfigured' honestly and never fakes a run.
# NOTE (phase17-lh): scheduler.py is LEGACY/DEV — the canonical scheduler is
# the Temporal Schedule registered by server/temporal/lakehouse-schedule.ts.
LAKEHOUSE_SCHEDULE_ENABLED=

# ── Lakehouse incremental export (Temporal-scheduled, phase17-lh) ───────────
# true = register the lakehouseExportWorkflow schedule (Temporal when
# TEMPORAL_EXECUTION_ENABLED=true; otherwise an honestly-logged in-process
# interval fallback). Default/unset = disabled, no runs occur.
LAKEHOUSE_EXPORT_ENABLED=
# Cron for the export schedule. Temporal path accepts full cron syntax; the
# interval fallback supports only @hourly|@daily|@weekly|*/N * * * *.
LAKEHOUSE_EXPORT_CRON=
# Spark-side analytics query endpoint (see docs/LAKEHOUSE.md "Query endpoint
# contract"). When unset/unreachable, lakehouseAnalytics procedures fall back
# to Postgres aggregation and label responses source='postgres_fallback'.
LAKEHOUSE_QUERY_URL=

# ── Readiness probe ─────────────────────────────────────────────────────────
# /readyz downstream-check timeout (ms)
READYZ_TIMEOUT_MS=

# ── Redis Sentinel (HA deployments; REDIS_URL alone for single-node) ────────
REDIS_SENTINELS=
REDIS_SENTINEL_PASSWORD=
REDIS_MASTER_NAME=

# ── PHI retention purge (server/scheduled/retentionWorker.ts) ───────────────
# Retention window (days) for fhir_resource_cache / smart_form_extractions (default 90)
RETENTION_DAYS=
# In-process purge interval (ms; default daily). 0 disables the interval when
# an external cron drives POST /api/scheduled/retention-purge instead.
RETENTION_SWEEP_INTERVAL_MS=

# ── Portal RPA (IDR entity portals) ─────────────────────────────────────────
# true = allow live (non-sandbox) RPA runs against external portals
RPA_LIVE_ENABLED=
# true = operator attestation that portal ToS permit automation
RPA_TOS_ACKNOWLEDGED=

# ── Submission automation ───────────────────────────────────────────────────
# true = fail closed on validation warnings during IDR submission packaging
SUBMISSION_STRICT=

# ── Temporal workflow engine ────────────────────────────────────────────────
TEMPORAL_TASK_QUEUE=
TEMPORAL_JOURNEYS_TASK_QUEUE=
TEMPORAL_WORKFLOW_TYPE=
TEMPORAL_STATUS_ACTOR_ID=
TEMPORAL_TLS_SERVER_NAME=

# ── TigerBeetle direct client (alternative to the Go sidecar) ───────────────
TIGERBEETLE_ENABLED=
TIGERBEETLE_CLUSTER_ID=
TIGERBEETLE_ADDRESS=
TIGERBEETLE_ASSURANCE=
TIGERBEETLE_TLS_REMOTE_ADDRESS=
TIGERBEETLE_TLS_SERVER_NAME=
TIGERBEETLE_CLIENT_KEY_PATH=
TIGERBEETLE_CLIENT_KEY_PEM=

# ── Phase 16: third-party submitter / CMS-9897-F batching ──────────────────
# Optional tightening override for the batched-dispute line-item cap. The
# statutory cap is effective-dated (25 before 2026-11-01, 50 on/after for
# open negotiation periods beginning on/after that date); an override may
# only tighten, never relax, the statutory cap.
IDR_BATCH_CAP=

# ── Phase 17: SMART Backend Services (EHR bulk/FHIR auth) ───────────────────
# Gate for OAuth2 client-credentials (UDAP-style private_key_jwt, RS384)
# token acquisition against EHR token endpoints. Must be exactly "true" to
# enable; when unset the connector fails closed (no token attempts).
SMART_BACKEND_SERVICES_ENABLED=
# Per-connection SMART credentials are stored ENCRYPTED on the emr_connections
# row (credentialsEncrypted, AES-256-GCM; see server/credential-crypto.ts) as
# JSON keys: smartClientId, smartPrivateKeyPem, smartKid (optional),
# smartTokenEndpoint (optional — discovered via .well-known/smart-configuration
# when absent), smartScope (optional). No values are stored in env.

# ── Phase 18: deadline autopilot (pre-expiry prevention sweep) ───────────────
# Comma-separated thresholds (business days before statutory hard deadlines)
# at which the autopilot emits notifications for the open-negotiation (30-bd),
# IDR-initiation (4-bd), and payment (30-calendar-day, calendar-day compare)
# windows. Default when unset: "5,2,1". Invalid values fail closed to the
# default. Mounted at POST /api/scheduled/deadline-autopilot (scheduledAuth).
DEADLINE_ALERT_DAYS=

# ── Phase 19: chunked resumable bulk claim ingestion ────────────────────────
# Master gate for the in-process checkpointed ingestion runner. Default ON;
# set to "false" in embedded-pg test environments to disable the boot-time
# resumePendingSessions() sweep (sessions in 'ready'/'ingesting' are resumed
# from their persisted watermark on boot when enabled).
BULK_INGEST_ENABLED=
# Drop-folder poller (default OFF — must be exactly "true" to start). Watches
# DROP_FOLDER_PATH for new stable files (size unchanged across two polls) and
# drives the SAME session/chunk/finalize/ingest pipeline as web uploads.
DROP_FOLDER_ENABLED=
DROP_FOLDER_PATH=
DROP_FOLDER_POLL_MS=
# JSON map of filename-prefix -> orgId, e.g. {"acme-":"org_abc123"}. Files
# whose prefix has no mapping are skipped (renamed .done and logged).
DROP_FOLDER_ORG_MAP=
# Optional user id recorded as created_by_user_id for drop-folder sessions.
DROP_FOLDER_UPLOADED_BY=
# SFTP intake is a DEPLOYMENT-LEVEL adapter only: schedule an external
# rsync/sftp pull into DROP_FOLDER_PATH (e.g. cron); no SFTP client is built
# into the platform in this phase.
