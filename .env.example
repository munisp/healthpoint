###############################################################################
# HealthPoint IDR — environment template
# Copy to .env and fill in real values. NEVER commit real secrets.
# Values below are empty or obvious placeholders only. Production startup
# validation (server/_core/index.ts validateEnv, server/_core/env.ts) fails
# closed when required variables are missing or malformed.
###############################################################################

# ── Core application ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# PostgreSQL connection string. Production requires the postgresql:// form
# (or EXTERNAL_POSTGRES_URL with sslmode=verify-ca + sslrootcert).
DATABASE_URL=postgresql://idr_user:change-me@localhost:5432/idr_demo
# Session/JWT signing secret — REQUIRED (min 16 chars; use 32+ random bytes).
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Comma-separated list of allowed CORS origins, exact match (production only)
ALLOWED_ORIGINS=

# ── PostgreSQL (docker-compose service) ─────────────────────────────────────
POSTGRES_USER=idr_user
POSTGRES_PASSWORD=
POSTGRES_DB=idr_demo

# ── Redis (cache, sessions, JWT revocation list, distributed locks) ──────────
REDIS_PASSWORD=
# Full URL consumed by the app; include the password: redis://:<password>@host:6379
REDIS_URL=redis://localhost:6379

# ── Keycloak OIDC (identity provider) ───────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=healthpoint
KEYCLOAK_CLIENT_ID=healthpoint-app
# Optional issuer override when the realm is fronted by a gateway; defaults to
# ${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM}
KEYCLOAK_ISSUER=
# Bootstrap admin password for the docker-compose `start-dev` Keycloak.
# docker-compose.yml requires it explicitly; start-dev is development-only.
KC_ADMIN_PASSWORD=

# ── Bearer access-token verification (mobile app + API clients) ─────────────
# RS256 Keycloak access tokens are verified against the realm JWKS
# (<issuer>/protocol/openid-connect/certs), cached with a TTL.
# Optional JWKS URI override:
KEYCLOAK_JWKS_URI=
# Comma-separated accepted audiences/azp values. Default: KEYCLOAK_CLIENT_ID
# plus healthpoint-app,healthpoint-frontend,healthpoint-backend.
KEYCLOAK_BEARER_AUDIENCES=healthpoint-app,healthpoint-frontend
# iss/exp clock-skew tolerance (seconds)
BEARER_CLOCK_TOLERANCE_SECONDS=60
# JWKS cache TTL (milliseconds)
KEYCLOAK_JWKS_CACHE_TTL_MS=300000

# ── Rate limiting (Redis-backed, server/auth/ratelimit.ts) ──────────────────
# /api/auth/* — strict; fails closed in production when Redis is unavailable
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# /api/settlement/* and /api/fhir/* — strict; fails closed in production
RATE_LIMIT_SENSITIVE_MAX=30
RATE_LIMIT_SENSITIVE_WINDOW_SECONDS=60
# /api/trpc/* — general limiter; fail-open-with-log (read-heavy, low risk)
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_SECONDS=60

# ── Settlement provider callbacks (REQUIRED in production) ──────────────────
# HMAC secret for signed settlement callbacks/reports
SETTLEMENT_CALLBACK_SECRET=
# Versioned keyring, e.g. key1=<hex-secret>,key2=<hex-secret>
SETTLEMENT_CALLBACK_KEYRING=
# Expected provider identifier (defaults to "mojaloop")
SETTLEMENT_CALLBACK_PROVIDER=mojaloop
# PEM of the CA that signs provider mTLS client certificates
SETTLEMENT_MTLS_CLIENT_CA_PEM=
# Comma-separated allowed provider client-certificate SHA-256 fingerprints
SETTLEMENT_MTLS_CLIENT_FINGERPRINTS=
# High-entropy (>= 32 chars) shared token verified at the mTLS ingress
SETTLEMENT_MTLS_INGRESS_TOKEN=

# ── Internal services ────────────────────────────────────────────────────────
# Shared bearer token for internal service-to-service calls (go-services)
INTERNAL_SERVICE_TOKEN=
# Base URL of the Go services (Permify client, Mojaloop connector, ledger)
GO_SERVICES_URL=http://localhost:8001

# ── MinIO / S3-compatible object storage ────────────────────────────────────
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ── OpenSearch (search indices; optional — falls back to in-process Fuse.js) ─
OPENSEARCH_URL=
# Basic-auth credentials for a secured OpenSearch cluster (optional)
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
# TLS certificate verification for an https:// OPENSEARCH_URL. Default: true
# in production, false in development (the compose OpenSearch runs with the
# security plugin disabled over plain HTTP). "false" is IGNORED (with an
# error log) when NODE_ENV=production — verification cannot be disabled there.
OPENSEARCH_VERIFY_TLS=

# ── Permify (fine-grained ReBAC authorization) ──────────────────────────────
# HTTP base URL of the Permify check API. Unset = PostgreSQL fallback in
# server/authz.ts. Canonical schema: infra/permify/schema.perm.
PERMIFY_URL=
PERMIFY_TENANT=t1
# Mirror-only Permify WRITE path (default false). When true,
# server/permify-write.ts mirrors tuples to PERMIFY_URL on organization
# membership creation (user_profiles.orgName) and dispute/case creation. It
# FAILS OPEN (error log + event_log audit row) because PostgreSQL remains the
# system of record and all authorization READS stay on the Postgres path in
# server/authz.ts — Permify is a mirror only until a product decision flips
# the read path.
PERMIFY_WRITE_ENABLED=false

# ── Temporal workflow execution (opt-in, disabled by default) ───────────────
TEMPORAL_EXECUTION_ENABLED=false
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_AUTH_TOKEN=
# Path to the Temporal CA certificate for mTLS (production)
TEMPORAL_CA_PATH=

# ── TigerBeetle ledger (authoritative funds plane via the Go sidecar) ───────
# false (default) = Postgres-only behavior; the ledger wrapper degrades with an
# error log. true enables mirroring of settlement holds/posts/voids/reversals.
TB_LEDGER_ENABLED=false
# true = fail CLOSED when the ledger is unavailable: settlement lifecycle and
# reconciliation throw LedgerIntegrityError instead of silently degrading.
TB_LEDGER_REQUIRED=false
TB_LEDGER_TIMEOUT_MS=3000
TB_LEDGER_PENDING_HOLD_TIMEOUT_SECONDS=86400

# ── Ledger reconciliation (Postgres ledger vs. TigerBeetle balances) ────────
# In-process scheduler cadence in minutes (server/reconciliation-scheduler.ts);
# default 60 = hourly. 0 disables the in-process scheduler (e.g. when an
# external cron drives POST /api/scheduled/ledger-reconciliation instead).
LEDGER_RECONCILIATION_INTERVAL_MINUTES=60

# ── Scheduled endpoints ──────────────────────────────────────────────────────
# Bearer fallback token for /api/scheduled/* — REQUIRED in production
# (startup fails closed without it). Generate with: openssl rand -hex 32
SCHEDULED_SECRET=

# ── Client (Vite build-time variables, exposed to the browser) ──────────────
VITE_APP_TITLE="HealthPoint"
VITE_APP_LOGO=/icons/icon-512.png
VITE_APP_URL=http://localhost:3000
